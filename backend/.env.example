# Copy to .env and adjust. Relative SQLite paths are resolved against the backend/ folder.
# PostgreSQL example: postgresql+psycopg://user:password@localhost:5432/linezero
DATABASE_URL=sqlite:///./data/linezero.db
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated list (or a JSON list) of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DEBUG=false
# Apply Alembic migrations automatically when the API starts
AUTO_MIGRATE=true

# Optional: Gemini explanations for the Digital Twin. Leave empty to use the built-in deterministic explanations.
# Get a key at https://aistudio.google.com/ and keep it ONLY in your local .env (never commit it).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
